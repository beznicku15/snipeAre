-- Funkcja do skanowania logiki lootu
function scanLootLogic()
    local results = {}
    local isClientSide = false
    local isServerSide = false
    local remoteEvents = {}

    -- Znajdź RemoteEventy związane z otwieraniem
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = obj.Name:lower()
            if name:find("loot") or name:find("crate") or name:find("chest") or name:find("open") or name:find("reward") then
                table.insert(remoteEvents, obj)
            end
        end
    end

    -- Sprawdź, czy istnieją lokalne skrypty, które mogą obsługiwać otwieranie
    local localScripts = {}
    local places = {game:GetService("StarterGui"), game:GetService("StarterPlayer").StarterPlayerScripts, game:GetService("StarterPack")}
    for _, place in pairs(places) do
        if place then
            for _, script in pairs(place:GetDescendants()) do
                if script:IsA("LocalScript") or script:IsA("ModuleScript") then
                    table.insert(localScripts, script)
                end
            end
        end
    end

    -- Sprawdź, czy w którymś skrypcie jest wzmianka o `math.random` lub `Random`
    for _, script in pairs(localScripts) do
        if script:IsA("LocalScript") and script.Name:lower():find("loot") or script.Name:lower():find("crate") then
            -- Jeśli istnieje skrypt o nazwie kojarzącej się z lootem, to prawdopodobnie logika jest po stronie klienta
            isClientSide = true
            table.insert(results, "🔍 Znaleziono lokalny skrypt: " .. script.Name .. " (prawdopodobnie logika po stronie klienta)")
        end
    end

    -- Jeśli są RemoteEventy, to logika może być po stronie serwera (ale nie musi – klient też może je wywoływać)
    if #remoteEvents > 0 then
        isServerSide = true
        table.insert(results, "📡 Znaleziono " .. #remoteEvents .. " RemoteEvent/ów powiązanych z lootem.")
        for _, ev in pairs(remoteEvents) do
            table.insert(results, "   - " .. ev.Name .. " (rodzic: " .. (ev.Parent and ev.Parent.Name or "brak") .. ")")
        end
    else
        table.insert(results, "❌ Nie znaleziono RemoteEventów powiązanych z lootem.")
    end

    -- Podsumowanie
    if isClientSide and isServerSide then
        table.insert(results, "⚠️ Logika może być po stronie KLIENTA i SERWERA – sprawdź, które wartości są zmieniane lokalnie.")
    elseif isClientSide then
        table.insert(results, "✅ Logika lootu jest najprawdopodobniej po stronie KLIENTA – możesz modyfikować szanse!")
    elseif isServerSide then
        table.insert(results, "❌ Logika lootu jest po stronie SERWERA – nie możesz zmienić szans, ale możesz automatyzować otwieranie.")
    else
        table.insert(results, "❓ Nie udało się jednoznacznie określić – spróbuj przeanalizować skrypty ręcznie.")
    end

    -- Wyświetl wyniki w GUI (notyfikacja)
    local msg = table.concat(results, "\n")
    Rayfield:Notify({
        Title = "🔎 Wyniki skanowania",
        Content = msg,
        Duration = 8
    })

    -- Wypisz też do konsoli
    print("=== WYNIKI SKANOWANIA LOOTU ===")
    for _, line in pairs(results) do
        print(line)
    end
    print("=================================")
end

-- Funkcje pomocnicze (z oryginału)
local function createLine(from, to, color)
    local line = Drawing.new("Line")
    line.Visible = true
    line.Color = color or Color3.fromRGB(255, 255, 255)
    line.Thickness = 1
    line.From = from
    line.To = to
    return line
end

local drawings = {}

local function getClosestTarget()
    local closest = nil
    local minDist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local isVisible = true
            if v2.VisCheck then
                local parts = Camera:GetPartsObscuringTarget({player.Character.Head.Position}, {LocalPlayer.Character, player.Character})
                if #parts > 0 then isVisible = false end
            end
            if isVisible then
                local screenPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function modifyWeaponStats()
    pcall(function()
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, child in pairs(tool:GetDescendants()) do
                if child:IsA("NumberValue") or child:IsA("DoubleConstrainedValue") or child:IsA("IntValue") then
                    if v2.NoRecoil and (child.Name:lower():find("recoil") or child.Name:lower():find("kick")) then
                        child.Value = 0
                    end
                    if v2.NoSpread and (child.Name:lower():find("spread") or child.Name:lower():find("accuracy")) then
                        child.Value = 0
                    end
                    if v2.FastReload and (child.Name:lower():find("reload") or child.Name:lower():find("time")) then
                        child.Value = 0.05
                    end
                end
            end
        end
    end)
end

-- Główna pętla
RunService.RenderStepped:Connect(function()
    -- Usuń stare rysunki
    for _, line in pairs(drawings) do
        line:Remove()
    end
    drawings = {}

    -- Speed
    if v2.Speed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        local root = LocalPlayer.Character.HumanoidRootPart
        if humanoid and root then
            if humanoid.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (humanoid.MoveDirection * v2.SpeedVal)
            end
        end
    end

    -- Jump, AutoStrafe
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local humanoid = LocalPlayer.Character.Humanoid
        if v2.Jump then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = v2.JumpVal
        end
        if v2.AutoStrafe and humanoid.MoveDirection.Magnitude > 0 then
            local vel = LocalPlayer.Character.HumanoidRootPart.Velocity
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(vel.X * 1.01, vel.Y, vel.Z * 1.01)
        end
    end

    -- ESP
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local head = char.Head
            local root = char.HumanoidRootPart

            -- Highlight (Box ESP)
            local highlight = char:FindFirstChild("PoloESP")
            if v2.ESP_Box then
                if not highlight then
                    highlight = Instance.new("Highlight", char)
                    highlight.Name = "PoloESP"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                end
            else
                if highlight then highlight:Destroy() end
            end

            -- Skeleton
            if v2.ESP_Skeleton then
                local function drawLine(a, b)
                    if a and b then
                        local posA, visA = Camera:WorldToViewportPoint(a.Position)
                        local posB, visB = Camera:WorldToViewportPoint(b.Position)
                        if visA and visB then
                            local line = createLine(Vector2.new(posA.X, posA.Y), Vector2.new(posB.X, posB.Y))
                            table.insert(drawings, line)
                        end
                    end
                end
                drawLine(head, char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
                drawLine(char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"), char:FindFirstChild("LowerTorso"))
            end

            -- Tracer
            if v2.ESP_Line then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local line = createLine(
                        Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y),
                        Vector2.new(pos.X, pos.Y),
                        Color3.fromRGB(255, 0, 0)
                    )
                    table.insert(drawings, line)
                end
            end

            -- Hitbox
            if v2.Hitbox then
                head.Size = Vector3.new(v2.HitboxSize, v2.HitboxSize, v2.HitboxSize)
                head.Transparency = 0.5
                head.CanCollide = false
            end
        end
    end

    -- Aimbot
    if v2.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getClosestTarget()
        if target then
            local pos, onScreen = Camera:WorldToViewportPoint(target.Character.Head.Position)
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local dx = pos.X - mousePos.X
                local dy = pos.Y - mousePos.Y
                mousemoverel(dx / v2.AimbotSmooth, dy / v2.AimbotSmooth)
            end
        end
    end

    -- TriggerBot
    if v2.TriggerBot then
        local target = Mouse.Target
        if target and target.Parent and target.Parent:FindFirstChild("Humanoid") then
            mouse1click()
        end
    end

    -- Weapon stats mod
    if v2.NoRecoil or v2.NoSpread or v2.FastReload then
        modifyWeaponStats()
    end

    -- Auto Loot (nowość)
    if v2.AutoLoot then
        -- Szukamy przycisków do otwierania
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("TextButton") then
                local name = obj.Name:lower()
                if name:find("open") or name:find("otwórz") or name:find("crate") or name:find("loot") then
                    pcall(function()
                        obj:Click()
                    end)
                end
            end
        end
        -- Próba wywołania RemoteEvent (jeśli znaleziony)
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local name = obj.Name:lower()
                if name:find("open") or name:find("loot") or name:find("crate") then
                    pcall(function()
                        obj:FireServer() -- bez argumentów, może nie działać
                    end)
                end
            end
        end
    end
end)

