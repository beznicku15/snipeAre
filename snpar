-- ==================== SYSTEM ZAPISU LOGÓW ====================
local logBuffer = {}
local logFile = "logs.txt" -- nazwa pliku (w folderze executora)

-- Funkcja dodająca wpis do bufora i zapisująca do pliku (jeśli możliwe)
local function addLog(text, level)
    level = level or "INFO"
    local timestamp = os.date("%Y-%m-%d %H:%M:%S")
    local entry = string.format("[%s] [%s] %s", timestamp, level, tostring(text))
    table.insert(logBuffer, entry)
    -- Jeśli bufor przekroczy 50 wpisów, zapisz automatycznie
    if #logBuffer >= 50 then
        saveLogs()
    end
end

-- Funkcja zapisująca cały bufor do pliku
local function saveLogs()
    if #logBuffer == 0 then return end
    local success, err = pcall(function()
        local content = table.concat(logBuffer, "\n") .. "\n"
        if writefile then
            -- Dopisujemy do istniejącego pliku
            local existing = readfile and readfile(logFile) or ""
            writefile(logFile, existing .. content)
        elseif game:GetService("HttpService") then
            -- Jeśli brak writefile, wyślij na serwer (opcjonalnie)
            -- Tu możesz dodać wysyłkę na swój serwer
            print("Brak writefile – logi tylko w konsoli")
        end
        logBuffer = {}
    end)
    if not success then
        warn("Nie udało się zapisać logów:", err)
    end
end

-- Nadpisanie globalnych funkcji print/warn/error, aby logowały
local oldPrint = print
local oldWarn = warn
local oldError = error

print = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    addLog(msg, "INFO")
    oldPrint(...)
end

warn = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    addLog(msg, "WARN")
    oldWarn(...)
end

error = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    addLog(msg, "ERROR")
    oldError(...)
end

-- Automatyczne zapisywanie logów co 30 sekund
task.spawn(function()
    while true do
        task.wait(30)
        saveLogs()
    end
end)

