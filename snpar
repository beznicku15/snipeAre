local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- Rysowanie linii (ESP)
local function drawLine(from, to, color)
    local line = Drawing.new("Line")
    line.Visible = true
    line.From = from
    line.To = to
    line.Color = color or Color3.fromRGB(255, 255, 255)
    line.Thickness = 1
    return line
end

-- Znajdź najbliższego wroga
local function getClosestEnemy()
    local bestDist = math.huge
    local bestTarget = nil
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local visible = true
            if v2.VisCheck then
                local parts = Camera:GetPartsObscuringTarget({player.Character.Head.Position}, {LocalPlayer.Character, player.Character})
                if #parts > 0 then visible = false end
            end
            if visible then
                local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestTarget = player
                    end
                end
            end
        end
    end
    return bestTarget
end

-- Modyfikacja broni
local function modifyWeapon()
    pcall(function()
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, child in pairs(tool:GetDescendants()) do
                if child:IsA("NumberValue") or child:IsA("DoubleConstrainedValue") or child:IsA("IntValue") then
                    local name = child.Name:lower()
                    if v2.NoRecoil and (name:find("recoil") or name:find("kick")) then
                        child.Value = 0
                    end
                    if v2.NoSpread and (name:find("spread") or name:find("accuracy")) then
                        child.Value = 0
                    end
                    if v2.FastReload and (name:find("reload") or name:find("time")) then
                        child.Value = 0.05
                    end
                end
            end
        end
    end)
end

-- ===== Główna pętla =====
local drawings = {}

RunService.RenderStepped:Connect(function()
    -- Czyść rysunki
    for _, d in pairs(drawings) do d:Remove() end
    drawings = {}

    -- Speed
    if v2.Speed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        local rootPart = LocalPlayer.Character.HumanoidRootPart
        if humanoid and rootPart and humanoid.MoveDirection.Magnitude > 0 then
            rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * v2.SpeedVal)
        end
    end

    -- Jump i AutoStrafe
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local humanoid = LocalPlayer.Character.Humanoid
        if v2.Jump then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = v2.JumpVal
        end
        if v2.AutoStrafe and humanoid.MoveDirection.Magnitude > 0 then
            local vel = LocalPlayer.Character.HumanoidRootPart.Velocity
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(vel.X * 1.01, vel.Y, vel.Z * 1.01)
        end
    end

    -- ESP i Hitbox dla przeciwników
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local head = char.Head
            local root = char.HumanoidRootPart
            local espObj = char:FindFirstChild("PoloESP")

            -- Box
            if v2.ESP_Box then
                if not espObj then
                    espObj = Instance.new("Highlight", char)
                    espObj.Name = "PoloESP"
                    espObj.FillColor = Color3.fromRGB(255, 0, 0)
                    espObj.OutlineColor = Color3.fromRGB(255, 255, 255)
                    espObj.FillTransparency = 0.5
                end
            elseif espObj then
                espObj:Destroy()
            end

            -- Skeleton
            if v2.ESP_Skeleton then
                local function drawBone(a, b)
                    if a and b then
                        local p1, v1 = Camera:WorldToViewportPoint(a.Position)
                        local p2, v2 = Camera:WorldToViewportPoint(b.Position)
                        if v1 and v2 then
                            table.insert(drawings, drawLine(Vector2.new(p1.X, p1.Y), Vector2.new(p2.X, p2.Y)))
                        end
                    end
                end
                drawBone(head, char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
                drawBone(char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"), char:FindFirstChild("LowerTorso"))
            end

            -- Tracer
            if v2.ESP_Line then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local bottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    table.insert(drawings, drawLine(bottom, Vector2.new(pos.X, pos.Y), Color3.fromRGB(255, 0, 0)))
                end
            end

            -- Hitbox (Big Head)
            if v2.Hitbox then
                head.Size = Vector3.new(v2.HitboxSize, v2.HitboxSize, v2.HitboxSize)
                head.Transparency = 0.5
                head.CanCollide = false
            end
        end
    end

    -- Aimbot
    if v2.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getClosestEnemy()
        if target then
            local pos, onScreen = Camera:WorldToViewportPoint(target.Character.Head.Position)
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local dx = pos.X - mousePos.X
                local dy = pos.Y - mousePos.Y
                mousemoverel(dx / v2.AimbotSmooth, dy / v2.AimbotSmooth)
            end
        end
    end

    -- TriggerBot
    if v2.TriggerBot then
        local target = Mouse.Target
        if target and target.Parent and target.Parent:FindFirstChild("Humanoid") then
            mouse1click()
        end
    end

    -- Modyfikacja broni
    if v2.NoRecoil or v2.NoSpread or v2.FastReload then
        modifyWeapon()
    end

    -- ===== NOWA funkcja: Auto Loot =====
    if v2.AutoLoot then
        -- 1. Szukamy przycisków "Open" / "Otwórz" i klikamy
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("TextButton") and obj.Visible and obj.Active then
                local name = obj.Name:lower()
                if name:find("open") or name:find("otwórz") or name:find("crate") or name:find("skrzyn") then
                    pcall(function()
                        obj:Click()
                    end)
                end
            end
        end

        -- 2. Szukamy RemoteEventów o nazwach związanych z otwieraniem i wywołujemy
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local name = obj.Name:lower()
                if name:find("open") or name:find("loot") or name:find("crate") or name:find("skrzyn") then
                    pcall(function()
                        obj:FireServer()  -- lub z argumentami, ale nie znamy ich
                    end)
                end
            end
        end
    end
end)

