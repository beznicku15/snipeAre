    Name = "🧠 Check Loot Logic (Client/Server)",
    Callback = function()
        print("🔍 Sprawdzanie logiki skrzynek...")

        local function HasLootPattern(sourceText)
            if not sourceText then return false end
            local text = sourceText:lower()
            local patterns = {
                "open",
                "loot",
                "crate",
                "reward",
                "drop",
                "rarity",
                "chance",
                "math.random",
                "random.new",
                "inventory",
                "item",
                "roll"
            }
            for _, pattern in ipairs(patterns) do
                if text:find(pattern, 1, true) then
                    return true
                end
            end
            return false
        end

        local clientMatches = {}
        local remoteMatches = {}
        local containers = {
            game:GetService("StarterPlayer"),
            game:GetService("StarterGui"),
            game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer.PlayerGui,
            game:GetService("ReplicatedStorage"),
            workspace
        }

        for _, container in ipairs(containers) do
            if container then
                for _, obj in ipairs(container:GetDescendants()) do
                    if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                        local src = obj.Source
                        if src and HasLootPattern(src) then
                            table.insert(clientMatches, obj:GetFullName())
                        end
                    elseif obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                        local name = (obj.Name or ""):lower()
                        if name:find("open") or name:find("loot") or name:find("crate") or name:find("reward") or name:find("drop") then
                            table.insert(remoteMatches, obj:GetFullName())
                        end
                    end
                end
            end
        end

        if #clientMatches > 0 then
            print("⚠️ Znaleziono potencjalną logikę kliencką:")
            for _, match in ipairs(clientMatches) do
                print("  - " .. match)
            end
        else
            print("✅ Nie znaleziono oczywistej logiki klienckiej.")
        end

        if #remoteMatches > 0 then
            print("📡 Znaleziono obiekty Remote związane z loot/drop:")
            for _, match in ipairs(remoteMatches) do
                print("  - " .. match)
            end
        else
            print("📡 Brak widocznych Remote dla loot/drop.")
        end

        if #clientMatches > 0 and #remoteMatches > 0 then
            print("🧠 Wniosek: istnieje zarówno logika klienta, jak i kanał sieciowy; to sugeruje częściowo zaufany flow klient-server.")
        elseif #clientMatches > 0 then
