-- Reszta skryptu (funkcje pomocnicze, pętla)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local function DrawLine(from, to, color)
    local line = Drawing.new("Line")
    line.Visible = true
    line.From = from
    line.To = to
    line.Color = color or Color3.fromRGB(255, 0, 0)
    line.Thickness = 1
    return line
end

local function GetClosestEnemy()
    local closest, dist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local visible = true
            if v2.VisCheck then
                local parts = Camera:GetPartsObscuringTarget(
                    {player.Character.Head.Position},
                    {LocalPlayer.Character, player.Character}
                )
                if #parts > 0 then visible = false end
            end
            if visible then
                local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if d < dist then
                        dist = d
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function ModifyWeapon()
    pcall(function()
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            for _, child in pairs(tool:GetDescendants()) do
                if child:IsA("NumberValue") or child:IsA("DoubleConstrainedValue") or child:IsA("IntValue") then
                    local name = child.Name:lower()
                    if v2.NoRecoil and (name:find("recoil") or name:find("kick")) then
                        child.Value = 0
                    end
                    if v2.NoSpread and (name:find("spread") or name:find("accuracy")) then
                        child.Value = 0
                    end
                    if v2.FastReload and (name:find("reload") or name:find("time")) then
                        child.Value = 0.05
                    end
                end
            end
        end
    end)
end

local drawings = {}

RunService.RenderStepped:Connect(function()
    for _, draw in pairs(drawings) do
        draw:Remove()
    end
    drawings = {}

    if v2.Speed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        local root = LocalPlayer.Character.HumanoidRootPart
        if humanoid and root then
            if humanoid.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (humanoid.MoveDirection * v2.SpeedVal)
            end
        end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local humanoid = LocalPlayer.Character.Humanoid
        if v2.Jump then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = v2.JumpVal
        end
        if v2.AutoStrafe and humanoid.MoveDirection.Magnitude > 0 then
            local vel = LocalPlayer.Character.HumanoidRootPart.Velocity
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(vel.X * 1.01, vel.Y, vel.Z * 1.01)
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character
            local head = char.Head
            local root = char.HumanoidRootPart

            if v2.ESP_Box then
                local hl = char:FindFirstChild("PoloESP")
                if not hl then
                    hl = Instance.new("Highlight", char)
                    hl.Name = "PoloESP"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                end
            else
                local hl = char:FindFirstChild("PoloESP")
                if hl then hl:Destroy() end
            end

            if v2.ESP_Skeleton then
                local function drawLine(joint1, joint2)
                    if joint1 and joint2 then
                        local p1, on1 = Camera:WorldToViewportPoint(joint1.Position)
                        local p2, on2 = Camera:WorldToViewportPoint(joint2.Position)
                        if on1 and on2 then
                            local line = DrawLine(Vector2.new(p1.X, p1.Y), Vector2.new(p2.X, p2.Y))
                            table.insert(drawings, line)
                        end
                    end
                end
                drawLine(head, char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
                drawLine(char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"), char:FindFirstChild("LowerTorso"))
            end

            if v2.ESP_Line then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local line = DrawLine(
                        Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y),
                        Vector2.new(pos.X, pos.Y),
                        Color3.fromRGB(255, 0, 0)
                    )
                    table.insert(drawings, line)
                end
            end

            if v2.Hitbox then
                head.Size = Vector3.new(v2.HitboxSize, v2.HitboxSize, v2.HitboxSize)
                head.Transparency = 0.5
                head.CanCollide = false
            end
        end
    end

    if v2.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = GetClosestEnemy()
        if target then
            local pos, onScreen = Camera:WorldToViewportPoint(target.Character.Head.Position)
            if onScreen then
                local mousePos = UserInputService:GetMouseLocation()
                local dx = pos.X - mousePos.X
                local dy = pos.Y - mousePos.Y
                mousemoverel(dx / v2.AimbotSmooth, dy / v2.AimbotSmooth)
            end
        end
    end

    if v2.TriggerBot then
        local target = Mouse.Target
        if target and target.Parent and target.Parent:FindFirstChild("Humanoid") then
            mouse1click()
        end
    end

    if v2.NoRecoil or v2.NoSpread or v2.FastReload then
        ModifyWeapon()
    end

    if v2.AutoLoot then
        pcall(function()
            if v2.LootMethod == "Click" then
                for _, obj in pairs(game:GetDescendants()) do
                    if obj:IsA("TextButton") then
                        local name = obj.Name:lower()
                        if name:find("open") or name:find("otwórz") or name:find("crate") then
                            obj:Click()
                        end
                    end
                end
            elseif v2.LootMethod == "Remote" then
                for _, obj in pairs(game:GetDescendants()) do
                    if obj:IsA("RemoteEvent") then
                        local name = obj.Name:lower()
                        if name:find("open") or name:find("crate") or name:find("loot") then
                            obj:FireServer()
                        end
                    end
                end
            end
        end)
    end
end)

