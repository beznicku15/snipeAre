-- ==================== SYSTEM ZAPISU LOGÓW (BEZ OS.DATE) ====================
local logBuffer = {}
local logFile = "logs.txt"

-- Funkcja dodająca wpis do bufora (bezpieczna)
local function addLog(text, level)
    level = level or "INFO"
    local timestamp = ""
    -- Używamy DateTime.now() zamiast os.date
    pcall(function()
        local now = DateTime.now()
        timestamp = now:Format("YYYY-MM-DD HH:mm:ss")
    end)
    if timestamp == "" then
        timestamp = "NO_TIME"
    end
    local entry = string.format("[%s] [%s] %s", timestamp, level, tostring(text))
    table.insert(logBuffer, entry)
    if #logBuffer >= 50 then
        saveLogs()
    end
end

-- Funkcja zapisująca bufor do pliku (bezpieczna)
local function saveLogs()
    if #logBuffer == 0 then return end
    local success, err = pcall(function()
        local content = table.concat(logBuffer, "\n") .. "\n"
        if writefile then
            local existing = readfile and readfile(logFile) or ""
            writefile(logFile, existing .. content)
        else
            -- Jeśli brak writefile, wypisz w konsoli (widoczne w F9)
            print("[LOG] " .. content)
        end
        logBuffer = {}
    end)
    if not success then
        warn("Nie udało się zapisać logów:", err)
    end
end

-- Nadpisanie globalnych funkcji print/warn/error
local oldPrint = print
local oldWarn = warn
local oldError = error

print = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    addLog(msg, "INFO")
    oldPrint(...)
end

warn = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    addLog(msg, "WARN")
    oldWarn(...)
end

error = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    addLog(msg, "ERROR")
    oldError(...)
end

-- Automatyczne zapisywanie logów co 30 sekund
task.spawn(function()
    while true do
        task.wait(30)
        saveLogs()
    end
end)

